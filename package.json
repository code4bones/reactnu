{
  "name": "reactnu",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @deadragdoll/reactnu && npm run build --workspace @reactnu/sandbox",
    "build-storybook": "npm run build:styles --workspace @deadragdoll/reactnu && storybook build",
    "dev:styles": "npm run watch:styles --workspace @deadragdoll/reactnu",
    "dev:sandbox": "npm run build:styles --workspace @deadragdoll/reactnu && npm run dev --workspace @reactnu/sandbox",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "npm run build:styles --workspace @deadragdoll/reactnu && storybook dev -p 6006",
    "typecheck": "tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p apps/sandbox/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "less": "^4.4.2",
    "prettier": "^3.6.2",
    "storybook": "^10.3.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.1"
  },
  "dependencies": {
    "panelgrid": "^0.4.4"
  }
}
